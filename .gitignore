# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Editor temporary files and per-machine settings
*.swp
*.swo
*~
.idea/
.vscode/*.local.json
.claude/settings.local.json

# Local environment values (keep safe example/template files)
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies and package-manager caches (keep lockfiles)
node_modules/
.pnpm-store/
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.yarn/build-state.yml

# Next.js output and generated TypeScript files
.next/
out/
next-env.d.ts
*.tsbuildinfo

# Build and tooling caches
/dist/
/build/
.cache/
.turbo/
.vercel/

# Test, coverage, and browser-run artifacts
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
test-results/
blob-report/

# Local TLS files
*.pem
*.key
